# Referencia MATLAB mantida apenas na copia local (regra existente)
/fracpaq-matlab/

# Python: bytecode, caches e ambientes virtuais
__pycache__/
*.py[cod]
*$py.class
.Python
.venv/
.venv-*/
venv/
env/
ENV/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.pytype/
.hypothesis/
.tox/
.nox/
.ipynb_checkpoints/
.matplotlib/
.cache/

# Builds, pacotes e instalacao local
/build/
/dist/
.eggs/
*.egg-info/
*.egg
pip-wheel-metadata/

# Cobertura e relatorios locais (preserva evidencias em tests/reference)
.coverage
.coverage.*
/htmlcov/
/coverage.xml
/junit.xml
/pytestdebug.log
/test-results/

# Variaveis de ambiente e credenciais locais; exemplos podem ser versionados
.env
.env.*
!.env.example
!.env.sample
!.env.template
/.aws/
/.codex/

# Exportacoes de execucao na raiz; nao ignora fixtures ou recursos do pacote
/FracPaQ2D*
/guiFracPaQ2D_*
/output/
/outputs/
/exports/
/logs/
/*.log
/*.log.*
.pyfracpaq-*

# Temporarios, backups e autosaves
/tmp/
/temp/
*.tmp
*.temp
*.bak
*.asv
*~
*.swp
*.swo
matlab_crash_dump.*

# Arquivos do sistema operacional
.DS_Store
._*
.Spotlight-V100/
.Trashes/
Thumbs.db
Desktop.ini

# IDEs: preserva as configuracoes compartilhadas existentes do VS Code
.vscode/*
!.vscode/settings.json
!.vscode/launch.json
!.vscode/tasks.json
.idea/

# tests/fixtures, tests/reference e pyfracpaq/resources sao versionaveis.
# Nao ignorar globalmente PNG, TXT, MAT ou NPZ: fazem parte da validacao.

# Intermediarios LaTeX do manual; fontes, figuras e PDF final sao versionaveis.
/docs/manual/build/
/docs/manual/*.aux
/docs/manual/*.log
/docs/manual/*.toc
/docs/manual/*.out
/docs/manual/*.fls
/docs/manual/*.fdb_latexmk
/docs/manual/*.xdv
/docs/manual/*.synctex.gz
