*.py[cod]
*$py.class
.Python
.venv/
.venv-*/
venv/
env/
ENV/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.pytype/
.hypothesis/
.tox/
.nox/
.ipynb_checkpoints/
.matplotlib/
.cache/

# Builds, packages and local installation
/build/
/dist/
.eggs/
*.egg-info/
*.egg
pip-wheel-metadata/

# Local coverage and reports (preserve evidence in tests/reference)
.coverage
.coverage.*
/htmlcov/
/coverage.xml
/junit.xml
/pytestdebug.log
/test-results/

# Local environment variables and credentials; examples may be versioned
.env
.env.*
!.env.example
!.env.sample
!.env.template
/.aws/
/.codex/

# Root-level analysis exports; fixtures and package resources remain versionable
/FracPaQ2D*
/guiFracPaQ2D_*
/output/
/outputs/
/exports/
/logs/
/*.log
/*.log.*
.pyfracpaq-*

# Temporary files, backups and autosaves
/tmp/
/temp/
*.tmp
*.temp
*.bak
*.asv
*~
*.swp
*.swo
matlab_crash_dump.*

# Operating system files
.DS_Store
._*
.Spotlight-V100/
.Trashes/
Thumbs.db
Desktop.ini

# IDEs: preserve existing shared VS Code configurations
.vscode/*
!.vscode/settings.json
!.vscode/launch.json
!.vscode/tasks.json
.idea/

# tests/fixtures, tests/reference and pyfracpaq/resources are versionable.
